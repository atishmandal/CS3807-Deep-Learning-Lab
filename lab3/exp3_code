import time
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import layers, models, datasets
from sklearn.metrics import classification_report, confusion_matrix
import seaborn as sns


(X_train_orig, y_train_orig), (X_test_orig, y_test_orig) = datasets.cifar10.load_data()
class_names = ['airplane', 'automobile', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck']

print(f"Train set shape: {X_train_orig.shape}, Labels shape: {y_train_orig.shape}")
print(f"Test set shape:  {X_test_orig.shape}, Labels shape:  {y_test_orig.shape}")


plt.figure(figsize=(10, 4))
for i in range(10):
    plt.subplot(2, 5, i + 1)
    plt.imshow(X_train_orig[i])
    plt.title(class_names[y_train_orig[i][0]])
    plt.axis('off')
plt.suptitle("Sample CIFAR-10 Images")
plt.tight_layout()
plt.show()

plt.figure(figsize=(8, 4))
unique, counts = np.unique(y_train_orig, return_counts=True)
plt.bar(class_names, counts, color='skyblue', edgecolor='black')
plt.title("Class Distribution in Training Set")
plt.xlabel("Class Name")
plt.ylabel("Number of Images")
plt.xticks(rotation=45)
plt.show()

X_train = X_train_orig.astype('float32') / 255.0
X_test = X_test_orig.astype('float32') / 255.0



print("\n--- Kernel Size & Hyperparameter Dimension Test ---")
test_input = tf.zeros((1, 32, 32, 3))

for k_size in [3, 5, 7]:
    conv_layer = layers.Conv2D(filters=16, kernel_size=(k_size, k_size), padding='valid')
    out_shape = conv_layer(test_input).shape
    print(f"Kernel: {k_size}x{k_size} | Padding: 'valid' | Output Shape: {out_shape[1:3]}")

for stride in [1, 2]:
    for pad in ['valid', 'same']:
        conv_layer = layers.Conv2D(filters=16, kernel_size=(3, 3), strides=stride, padding=pad)
        out_shape = conv_layer(test_input).shape
        print(f"Stride: {stride} | Padding: '{pad}' | Output Shape: {out_shape[1:3]}")


def build_pooling_model(pooling_layer_cls):
    return models.Sequential([
        layers.Conv2D(16, (3, 3), activation='relu', input_shape=(32, 32, 3), padding='same'),
        pooling_layer_cls((2, 2)),
        layers.Conv2D(32, (3, 3), activation='relu', padding='same'),
        pooling_layer_cls((2, 2)),
        layers.Flatten(),
        layers.Dense(64, activation='relu'),
        layers.Dense(10, activation='softmax')
    ])

pool_test_input = tf.zeros((1, 32, 32, 16))
max_out = layers.MaxPooling2D((2, 2))(pool_test_input).shape
avg_out = layers.AveragePooling2D((2, 2))(pool_test_input).shape
print(f"\nMaxPooling2D  output shape: {max_out[1:3]}")
print(f"AveragePooling2D output shape: {avg_out[1:3]}")

epochs_cmp = 10
batch_size = 32

model_max = build_pooling_model(layers.MaxPooling2D)
model_max.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
hist_max = model_max.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                          validation_data=(X_test, y_test_orig), verbose=2)

model_avg = build_pooling_model(layers.AveragePooling2D)
model_avg.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
hist_avg = model_avg.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                          validation_data=(X_test, y_test_orig), verbose=2)

plt.figure(figsize=(8, 4))
plt.plot(hist_max.history['val_accuracy'], label='Max Pooling (val)')
plt.plot(hist_avg.history['val_accuracy'], label='Average Pooling (val)')
plt.title('Max Pooling vs Average Pooling: Validation Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.legend()
plt.show()

print(f"Max Pooling final val accuracy: {hist_max.history['val_accuracy'][-1]:.4f}")
print(f"Average Pooling final val accuracy: {hist_avg.history['val_accuracy'][-1]:.4f}")

model = models.Sequential([
    layers.Conv2D(16, (3, 3), activation='relu', input_shape=(32, 32, 3), padding='same'),
    layers.MaxPooling2D((2, 2)),

    layers.Conv2D(32, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),

    layers.Flatten(),
    layers.Dense(64, activation='relu'),
    layers.Dense(10, activation='softmax')
])

model.summary()

model.compile(optimizer='adam',
              loss='sparse_categorical_crossentropy',
              metrics=['accuracy'])

epochs = 20
history = model.fit(X_train, y_train_orig,
                     epochs=epochs,
                     batch_size=batch_size,
                     validation_data=(X_test, y_test_orig))


first_conv_layer = model.layers[0]
feature_extractor = models.Model(inputs=model.inputs, outputs=first_conv_layer.output)

sample_img = np.expand_dims(X_test[0], axis=0)
feature_maps = feature_extractor.predict(sample_img)

plt.figure(figsize=(12, 6))
for i in range(8):
    plt.subplot(2, 4, i + 1)
    plt.imshow(feature_maps[0, :, :, i], cmap='viridis')
    plt.title(f"Feature Map {i+1}")
    plt.axis('off')
plt.suptitle("8 Feature Maps from First Convolutional Layer")
plt.show()

plt.figure(figsize=(8, 4))
plt.plot(history.history['accuracy'], label='Training Accuracy')
plt.plot(history.history['val_accuracy'], label='Validation Accuracy')
plt.title('Training vs Validation Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.legend()
plt.show()

plt.figure(figsize=(8, 4))
plt.plot(history.history['loss'], label='Training Loss')
plt.plot(history.history['val_loss'], label='Validation Loss')
plt.title('Training vs Validation Loss')
plt.xlabel('Epoch')
plt.ylabel('Loss')
plt.legend()
plt.show()

y_pred_probs = model.predict(X_test)
y_pred = np.argmax(y_pred_probs, axis=1)


cm = confusion_matrix(y_test_orig, y_pred)
plt.figure(figsize=(10, 8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)
plt.title('Confusion Matrix')
plt.xlabel('Predicted')
plt.ylabel('True')
plt.show()


print("\n--- Detailed Classification Report ---")
print(classification_report(y_test_orig, y_pred, target_names=class_names))

N, F, P, S = 64, 5, 2, 2
out_size = (N - F + 2 * P) / S + 1
print(f"\n--- Additional Exercise 1 ---")
print(f"Formula output size: {out_size} -> floor = {int(np.floor(out_size))}")

verify_input = tf.zeros((1, 64, 64, 3))
padded = layers.ZeroPadding2D(padding=P)(verify_input)
conv_check = layers.Conv2D(filters=8, kernel_size=F, strides=S, padding='valid')(padded)
print(f"Verified via Keras layer: output shape = {conv_check.shape[1:3]}")


filters_ex2, kernel_ex2, channels_ex2 = 64, 3, 3
params_ex2 = (kernel_ex2 * kernel_ex2 * channels_ex2 + 1) * filters_ex2
print(f"\n--- Additional Exercise 2 ---")
print(f"Trainable parameters: ({kernel_ex2}x{kernel_ex2}x{channels_ex2} + 1) x {filters_ex2} = {params_ex2}")

verify_layer = layers.Conv2D(filters=filters_ex2, kernel_size=(kernel_ex2, kernel_ex2),
                              input_shape=(32, 32, channels_ex2))
verify_layer.build((None, 32, 32, channels_ex2))
print(f"Verified via Keras layer: {verify_layer.count_params()} parameters")

def build_activation_model(activation_fn):
    return models.Sequential([
        layers.Conv2D(16, (3, 3), activation=activation_fn, input_shape=(32, 32, 3), padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(32, (3, 3), activation=activation_fn, padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Flatten(),
        layers.Dense(64, activation=activation_fn),
        layers.Dense(10, activation='softmax')
    ])

model_relu = build_activation_model('relu')
model_relu.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
hist_relu = model_relu.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                            validation_data=(X_test, y_test_orig), verbose=2)

model_sigmoid = build_activation_model('sigmoid')
model_sigmoid.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
hist_sigmoid = model_sigmoid.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                                  validation_data=(X_test, y_test_orig), verbose=2)

plt.figure(figsize=(8, 4))
plt.plot(hist_relu.history['val_accuracy'], label='ReLU (val)')
plt.plot(hist_sigmoid.history['val_accuracy'], label='Sigmoid (val)')
plt.title('ReLU vs Sigmoid: Validation Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.legend()
plt.show()

print(f"\nReLU final val accuracy: {hist_relu.history['val_accuracy'][-1]:.4f}")
print(f"Sigmoid final val accuracy: {hist_sigmoid.history['val_accuracy'][-1]:.4f}")

print("\n--- Additional Exercise 4 ---")
print("See Task 5 comparison above (model_max vs model_avg).")

def build_filter_model(f1, f2):
    return models.Sequential([
        layers.Conv2D(f1, (3, 3), activation='relu', input_shape=(32, 32, 3), padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(f2, (3, 3), activation='relu', padding='same'),
        layers.MaxPooling2D((2, 2)),
        layers.Flatten(),
        layers.Dense(64, activation='relu'),
        layers.Dense(10, activation='softmax')
    ])

model_16 = build_filter_model(16, 32)
model_64 = build_filter_model(64, 128)

model_16.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
start = time.time()
hist_16 = model_16.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                        validation_data=(X_test, y_test_orig), verbose=2)
time_16 = time.time() - start

model_64.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
start = time.time()
hist_64 = model_64.fit(X_train, y_train_orig, epochs=epochs_cmp, batch_size=batch_size,
                        validation_data=(X_test, y_test_orig), verbose=2)
time_64 = time.time() - start

print(f"\n--- Additional Exercise 5 ---")
print(f"16-filter model: val_acc={hist_16.history['val_accuracy'][-1]:.4f}, "
      f"params={model_16.count_params()}, train_time={time_16:.1f}s")
print(f"64-filter model: val_acc={hist_64.history['val_accuracy'][-1]:.4f}, "
      f"params={model_64.count_params()}, train_time={time_64:.1f}s")
